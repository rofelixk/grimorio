{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/fields/**",
              "components/identity/**",
              "components/modal/**",
              "components/profile/**",
              "components/shell/**",
              "components/status/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Grenze|Karla))/i]",
        "message": "Font not provided by the design system. Available: Grenze, Karla."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|block|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, block, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|className|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: as, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdentityChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:colors|label|key|ref|className|style|children)$/]",
        "message": "<IdentityChip> doesn't accept that prop. Declared props: colors, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdentityWheel'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|picks|neutral|subline|size|onChange|key|ref|className|style|children)$/]",
        "message": "<IdentityWheel> doesn't accept that prop. Declared props: mode, picks, neutral, subline, size, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdentityWheel'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:picker|display)$/]",
        "message": "<IdentityWheel> mode must be one of 'picker' | 'display'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<LinkButton> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicroLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|className|children|key|ref|className|style|children)$/]",
        "message": "<MicroLabel> doesn't accept that prop. Declared props: as, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MiniWheel'] > JSXAttribute > JSXIdentifier[name!=/^(?:colors|key|ref|className|style|children)$/]",
        "message": "<MiniWheel> doesn't accept that prop. Declared props: colors."
      },
      {
        "selector": "JSXOpeningElement[name.name='Plate'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|role|children|key|ref|className|style|children)$/]",
        "message": "<Plate> doesn't accept that prop. Declared props: eyebrow, role, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfileRowProfile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|colors|linked|key|ref|className|style|children)$/]",
        "message": "<ProfileRowProfile> doesn't accept that prop. Declared props: name, colors, linked."
      },
      {
        "selector": "JSXOpeningElement[name.name='SparkField'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|direction|key|ref|className|style|children)$/]",
        "message": "<SparkField> doesn't accept that prop. Declared props: count, direction."
      },
      {
        "selector": "JSXOpeningElement[name.name='SparkField'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:outward|inward)$/]",
        "message": "<SparkField> direction must be one of 'outward' | 'inward'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SyncLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|key|ref|className|style|children)$/]",
        "message": "<SyncLine> doesn't accept that prop. Declared props: state, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SyncLine'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:pending|done|failed)$/]",
        "message": "<SyncLine> state must be one of 'pending' | 'done' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|name|type|value|onChange|helper|error|readOnly|readonly|autoComplete|inputMode|maxLength|placeholder|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, id, name, type, value, onChange, helper, error, readOnly, readonly, autoComplete, inputMode, maxLength, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|password)$/]",
        "message": "<TextField> type must be one of 'text' | 'email' | 'password'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='inputMode'] > Literal[value!=/^(?:numeric|text|email)$/]",
        "message": "<TextField> inputMode must be one of 'numeric' | 'text' | 'email'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemedModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|roles|aside|caption|title|subtitle|titleId|prompt|chip|onClose|layout|inline|sparks|children|key|ref|className|style|children)$/]",
        "message": "<ThemedModal> doesn't accept that prop. Declared props: open, roles, aside, caption, title, subtitle, titleId, prompt, chip, onClose, layout, inline, sparks, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemedModal'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:auto|desktop|mobile)$/]",
        "message": "<ThemedModal> layout must be one of 'auto' | 'desktop' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
