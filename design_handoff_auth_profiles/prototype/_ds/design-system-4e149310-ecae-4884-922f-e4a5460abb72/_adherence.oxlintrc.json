{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chrome/**",
              "components/collection/**",
              "components/core/**",
              "components/mtg/**",
              "ui_kits/grimorio-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Grenze|Karla))/i]",
        "message": "Font not provided by the design system. Available: Grenze, Karla."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|onSignIn|onSignOut|onProfile|key|ref|className|style|children)$/]",
        "message": "<AuthControl> doesn't accept that prop. Declared props: name, onSignIn, onSignOut, onProfile."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|touch|fullWidth|disabled|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, touch, fullWidth, disabled, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|filled|secondary|danger|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'filled' | 'secondary' | 'danger' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardArt'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|colors|radius|style|key|ref|className|style|children)$/]",
        "message": "<CardArt> doesn't accept that prop. Declared props: src, name, colors, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardRowList'] > JSXAttribute > JSXIdentifier[name!=/^(?:cards|onRemove|onSelect|key|ref|className|style|children)$/]",
        "message": "<CardRowList> doesn't accept that prop. Declared props: cards, onRemove, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScatterCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|imageUrl|quantity|colorIdentity|key|ref|className|style|children)$/]",
        "message": "<ScatterCard> doesn't accept that prop. Declared props: id, name, imageUrl, quantity, colorIdentity."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorIdentity'] > JSXAttribute > JSXIdentifier[name!=/^(?:colors|size|key|ref|className|style|children)$/]",
        "message": "<ColorIdentity> doesn't accept that prop. Declared props: colors, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorThemePicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|max|onToggle|size|key|ref|className|style|children)$/]",
        "message": "<ColorThemePicker> doesn't accept that prop. Declared props: selected, max, onToggle, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='DashboardPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|viewAllLabel|onViewAll|children|key|ref|className|style|children)$/]",
        "message": "<DashboardPanel> doesn't accept that prop. Declared props: title, viewAllLabel, onViewAll, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, body, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntityList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|emptyLabel|formLabel|addLabel|placeholder|onRemove|onAdd|key|ref|className|style|children)$/]",
        "message": "<EntityList> doesn't accept that prop. Declared props: items, emptyLabel, formLabel, addLabel, placeholder, onRemove, onAdd."
      },
      {
        "selector": "JSXOpeningElement[name.name='FusedBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<FusedBar> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|helper|error|as|rows|type|value|placeholder|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, helper, error, as, rows, type, value, placeholder, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea)$/]",
        "message": "<Input> as must be one of 'input' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocationStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:locations|columns|onOpen|onAdd|addLabel|key|ref|className|style|children)$/]",
        "message": "<LocationStrip> doesn't accept that prop. Declared props: locations, columns, onOpen, onAdd, addLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ManaSymbol'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|size|title|style|key|ref|className|style|children)$/]",
        "message": "<ManaSymbol> doesn't accept that prop. Declared props: code, size, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|right|showMenu|onMenu|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: brand, right, showMenu, onMenu."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchToolbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|onModeChange|value|onValueChange|onSearch|searching|helper|key|ref|className|style|children)$/]",
        "message": "<SearchToolbar> doesn't accept that prop. Declared props: mode, onModeChange, value, onValueChange, onSearch, searching, helper."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchToolbar'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:name|setCode)$/]",
        "message": "<SearchToolbar> mode must be one of 'name' | 'setCode'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|glow|fused|key|ref|className|style|children)$/]",
        "message": "<SegmentedToggle> doesn't accept that prop. Declared props: options, value, onChange, glow, fused."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spinner'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|key|ref|className|style|children)$/]",
        "message": "<Spinner> doesn't accept that prop. Declared props: size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:owned|not-owned|removed)$/]",
        "message": "<StatusBadge> tone must be one of 'owned' | 'not-owned' | 'removed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemedModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|width|halo|onClose|actions|children|key|ref|className|style|children)$/]",
        "message": "<ThemedModal> doesn't accept that prop. Declared props: open, title, width, halo, onClose, actions, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeScope'] > JSXAttribute > JSXIdentifier[name!=/^(?:colors|as|style|children|key|ref|className|style|children)$/]",
        "message": "<ThemeScope> doesn't accept that prop. Declared props: colors, as, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ViewHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|breadcrumb|title|stats|actions|key|ref|className|style|children)$/]",
        "message": "<ViewHeader> doesn't accept that prop. Declared props: eyebrow, breadcrumb, title, stats, actions."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
