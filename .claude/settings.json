{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(type .env)",
      "Bash(Get-Content .env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck-lint.sh\""
          }
        ]
      }
    ]
  }
}
