{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@shared/interfaces": ["../src/app/shared/interfaces/index.ts"],
      "@shared/constants": ["../src/app/shared/constants/index.ts"]
    }
  },
  "include": ["*.ts"]
}
